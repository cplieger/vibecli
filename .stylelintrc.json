{
  "$schema": "https://json.schemastore.org/stylelintrc",
  "extends": ["stylelint-config-standard"],
  "defaultSeverity": "error",
  "reportDescriptionlessDisables": true,
  "reportInvalidScopeDisables": true,
  "reportNeedlessDisables": true,
  "reportUnscopedDisables": true,
  "rules": {
    "declaration-block-single-line-max-declarations": null,
    "declaration-no-important": true,
    "declaration-property-value-no-unknown": true,
    "function-no-unknown": true,
    "max-nesting-depth": [
      4,
      {
        "ignore": ["blockless-at-rules", "pseudo-classes"]
      }
    ],
    "no-unknown-animations": true,
    "no-unknown-custom-properties": true,
    "number-max-precision": [
      4,
      {
        "insideFunctions": {
          "/^(oklch|oklab|lch|lab|color-mix)$/": 6
        }
      }
    ],
    "selector-max-id": 0,
    "color-named": "never",
    "color-hex-alpha": "never",
    "font-weight-notation": "numeric",
    "selector-no-qualifying-type": [
      true,
      {
        "ignore": ["attribute", "class"]
      }
    ],
    "selector-max-compound-selectors": 5,
    "selector-max-specificity": "0,4,3",
    "selector-max-pseudo-class": 3,
    "selector-max-attribute": 2,
    "selector-max-combinators": 4,
    "selector-max-universal": 1,
    "time-min-milliseconds": 10,
    "at-rule-no-vendor-prefix": true,
    "property-no-vendor-prefix": [
      true,
      {
        "ignoreProperties": ["text-size-adjust", "font-smoothing", "tap-highlight-color"]
      }
    ],
    "value-no-vendor-prefix": [
      true,
      {
        "ignoreValues": ["box", "inline-box"]
      }
    ],
    "selector-no-vendor-prefix": true,
    "media-feature-name-no-vendor-prefix": true,
    "no-descending-specificity": null,
    "no-duplicate-selectors": null,
    "comment-empty-line-before": null,
    "rule-empty-line-before": null
  },
  "referenceFiles": "**/*.css",
  "overrides": [
    {
      "comment": "The app's only hand-written CSS is the critical block embedded in static/index.html: the self-sufficient #loading fatal surface. It is id-scoped on purpose (#loading is this app's own element, and the library selects the overlay by class precisely so it never reaches for our id), so selector-max-id and its specificity companion cannot apply here. hue-degree-notation is off for the same kind of reason: the accent literal hsl(263.1683 100% 80%) is one of FOUR independent spellings of one color (app.ts's createTerminal theme, this block, <meta name=\"theme-color\">, manifest.json), pinned byte-for-byte by app.test.ts's brand-accent parity test, so this file cannot adopt the deg suffix unilaterally. Every other rule still does apply -- no-unknown-custom-properties is the one that catches a typo'd --wt-loading-accent silently reverting the overlay to the library's default.",
      "files": ["**/*.html"],
      "customSyntax": "postcss-html",
      "rules": {
        "selector-max-id": null,
        "selector-max-specificity": null,
        "hue-degree-notation": null
      }
    }
  ]
}
